# ────────────────────────────────────────────────────────────────────────
# .env.example — шаблон переменных окружения.
#
# СКОПИРУЙ В .env И ЗАПОЛНИ СВОИМИ НАСТРОЙКАМИ:
#   cp .env.example .env     (Linux/Mac)
#   copy .env.example .env   (Windows PowerShell)
#
# .env НЕ коммитится в git (добавлен в .gitignore).
# ────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────
# Django core — PROD-007 / F-11 configuration contract
#
# DJANGO_DEBUG ОБЯЗАТЕЛЕН и явный:
#   • "true"  → DEVELOPMENT (разрешены dev-дефолты: "*" hosts, localhost CORS)
#   • "false" → PRODUCTION   (строгий режим, fail closed)
#   Без значения или с невалидным значением проект НЕ ЗАПУСТИТСЯ
#   (ImproperlyConfigured).
#
# В PRODUCTION ОБЯЗАТЕЛЬНО задайте:
#   • DJANGO_SECRET_KEY      — случайная строка (НЕ django-insecure-* !)
#   • DJANGO_ALLOWED_HOSTS   — явный список хостов через запятую (без "*")
#   • CORS_ALLOW_ALL_ORIGINS — "False" (разрешающий CORS запрещён)
# ────────────────────────────────────────────────────────────────────────

# Development example (локальная разработка):
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Production example (раскомментируйте и заполните для боевого запуска):
# Полный шаблон production-окружения — .env.production.example
# (docker-compose.prod.yml, PROD-008 / F-12: docs/production/DEPLOYMENT.md)
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_ALLOWED_HOSTS=api.example.com,www.example.com
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ── Database: PostgreSQL ──
# ВАЖНО: заполните ВСЕ 6 переменных!
# Создайте базу заранее (см. SETUP_GUIDE.md)
#   (или через pgAdmin: Create → Database → amazone_clone)
#
# PostgreSQL adapter:
#   psycopg3 (psycopg[binary]) — РЕКОМЕНДУЕТСЯ (Django 4.2+)
#   psycopg2-binary — устаревший fallback
#   Django автоматически определяет, какой адаптер установлен.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=amazone_clone
DB_USER=postgres
DB_PASSWORD=change-me-to-your-password
DB_HOST=localhost
DB_PORT=5432

# Для SQLite (без PostgreSQL) — просто НЕ задайте DB_ENGINE,
# или закомментируйте все DB_ строки. Django использует SQLite по умолчанию.
# ВНИМАНИЕ: SQLite допустим только в dev/test. Production-деплой
# (docker-compose.prod.yml) всегда использует PostgreSQL (PROD-008 / F-12).

# ── Redis (Celery broker/result backend) ──
# Локальная разработка без Docker: redis://localhost:6379/0
# В docker-compose (dev и prod) задаётся автоматически.
REDIS_URL=redis://localhost:6379/0

# CORS — откуда React может обращаться к Django.
# Эти значения — DEV-дефолты (localhost). В PRODUCTION задайте
# CORS_ALLOW_ALL_ORIGINS=False и явный CORS_ALLOWED_ORIGINS (см. блок выше).
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Throttling (по умолчанию 60/min anon, 120/min user)
THROTTLE_ANON=60/min
THROTTLE_USER=120/min

# ── Payment Webhook Security (HMAC-SHA256) ──
# Secret for verifying webhook signatures from payment provider.
# MUST be set in production. Without it, webhooks are rejected (403).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=
