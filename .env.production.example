# ────────────────────────────────────────────────────────────────────────
# .env.production.example — PROD-008 / F-12 шаблон production-окружения.
#
# КОПИРОВАНИЕ:
#   cp .env.production.example .env.production
#   # затем ЗАПОЛНИТЕ все обязательные значения
#
# Файл .env.production игнорируется git (.gitignore) и НИКОГДА не
# коммитится. Здесь — только безопасные примеры-заполнители.
#
# Использование:
#   ./scripts/prod.sh up
#   # эквивалент: docker compose -f docker-compose.prod.yml \
#   #              --env-file .env.production up -d
#
# Полная инструкция: docs/production/DEPLOYMENT.md
# ────────────────────────────────────────────────────────────────────────

# ══════════════════════ ОБЯЗАТЕЛЬНО (fail-closed) ══════════════════════

# Django SECRET_KEY. Пустое значение → приложение откажется стартовать.
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Хосты, обслуживаемые Django (заголовок Host). Явный список, без "*".
# Внутренние имена (web, localhost, 127.0.0.1) docker-compose.prod.yml
# добавляет автоматически.
DJANGO_ALLOWED_HOSTS=api.example.com

# PostgreSQL. Пустой POSTGRES_PASSWORD → весь стек откажется подниматься.
POSTGRES_DB=amazonclone
POSTGRES_USER=amazonclone
POSTGRES_PASSWORD=

# ════════════════════════ НЕ ОБЯЗАТЕЛЬНО ═══════════════════════════════

# DJANGO_DEBUG в production жёстко "False" в docker-compose.prod.yml —
# менять здесь НЕ нужно (значение из этого файла игнорируется стеком).
# DJANGO_DEBUG=False

# CORS (PROD-007): разрешающий CORS в production запрещён.
# Укажите явные origin'ы фронтенда.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://example.com

# Django admin за прокси с https — доверенные origin для CSRF.
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Публичный порт nginx на хосте (по умолчанию 8080).
PROD_HTTP_PORT=8080

# Gunicorn (web): число воркеров и таймаут запроса.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# HMAC-SHA256 secret для вебхуков платёжного провайдера (обязателен для
# работы payments-интеграции; без него вебхуки отклоняются с 403).
# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=

# Throttling.
THROTTLE_ANON=60/min
THROTTLE_USER=120/min

# Email (production default — SMTP-бэкенд). Значения ниже — безопасные
# заполнители; реальные SMTP-параметры задаёт оператор.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
FRONTEND_URL=https://example.com
