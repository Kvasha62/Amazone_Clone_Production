# ────────────────────────────────────────────────────────────────────────
# .dockerignore — исключаем из контекста сборки Docker
# ────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/

# Node
frontend/node_modules/
frontend/dist/
frontend/.cache/

# IDE
.idea/
.vscode/
*.swp

# Docker
.docker/

# Git
.git/
.gitignore

# Документация (не нужна в контейнере)
*.md
*.pdf
*.html

# Медиа (примонтируем через volume)
uploads/
media/
staticfiles/

# SQLite (используем PostgreSQL в Docker)
db.sqlite3
db.sqlite3-journal

# Окружение — СЕКРЕТЫ НИКОГДА не попадают в образ (PROD-008 / F-12)
.env
.env.*

# Docker
docker-compose*.yml

# CI
.github/
